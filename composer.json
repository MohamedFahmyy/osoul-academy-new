{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "laravel/react-starter-kit",
    "type": "project",
    "description": "The skeleton application for the Laravel framework.",
    "keywords": [
        "laravel",
        "framework"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "anhskohbo/no-captcha": "^3.8",
        "inertiajs/inertia-laravel": "^3.0",
        "laravel/ai": "^0.6.7",
        "laravel/framework": "^13.0",
        "laravel/sanctum": "^4.3",
        "laravel/socialite": "^5.26",
        "laravel/tinker": "^3.0",
        "laravel/wayfinder": "^0.1.14",
        "league/flysystem-aws-s3-v3": "^3.32",
        "mollie/laravel-mollie": "^4.1",
        "nwidart/laravel-modules": "^13.0",
        "paytm/paytmchecksum": "^1.1",
        "razorpay/razorpay": "^2.9",
        "spatie/laravel-medialibrary": "^11.21",
        "spatie/laravel-sitemap": "^8.0",
        "srmklive/paypal": "^3.1",
        "stripe/stripe-php": "^20.0"
    },
    "require-dev": {
        "fakerphp/faker": "^1.24",
        "laravel/boost": "^2.4",
        "laravel/pail": "^1.2.5",
        "laravel/pint": "^1.27",
        "laravel/sail": "^1.53",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.9",
        "pestphp/pest": "^4.4",
        "pestphp/pest-plugin-laravel": "^4.1"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/",
            "Modules\\ASAP\\": "Modules/ASAP/app/",
            "Modules\\ASAP\\Database\\Factories\\": "Modules/ASAP/database/factories/",
            "Modules\\ASAP\\Database\\Seeders\\": "Modules/ASAP/database/seeders/",
            "Modules\\Billing\\": "Modules/Billing/app/",
            "Modules\\Billing\\Database\\Factories\\": "Modules/Billing/database/factories/",
            "Modules\\Billing\\Database\\Seeders\\": "Modules/Billing/database/seeders/",
            "Modules\\Blog\\": "Modules/Blog/app/",
            "Modules\\Blog\\Database\\Factories\\": "Modules/Blog/database/factories/",
            "Modules\\Blog\\Database\\Seeders\\": "Modules/Blog/database/seeders/",
            "Modules\\Certification\\": "Modules/Certification/app/",
            "Modules\\Certification\\Database\\Factories\\": "Modules/Certification/database/factories/",
            "Modules\\Certification\\Database\\Seeders\\": "Modules/Certification/database/seeders/",
            "Modules\\Course\\": "Modules/Course/app/",
            "Modules\\Course\\Database\\Factories\\": "Modules/Course/database/factories/",
            "Modules\\Course\\Database\\Seeders\\": "Modules/Course/database/seeders/",
            "Modules\\Exam\\": "Modules/Exam/app/",
            "Modules\\Exam\\Database\\Factories\\": "Modules/Exam/database/factories/",
            "Modules\\Exam\\Database\\Seeders\\": "Modules/Exam/database/seeders/",
            "Modules\\Frontend\\": "Modules/Frontend/app/",
            "Modules\\Frontend\\Database\\Factories\\": "Modules/Frontend/database/factories/",
            "Modules\\Frontend\\Database\\Seeders\\": "Modules/Frontend/database/seeders/",
            "Modules\\Installer\\": "Modules/Installer/app/",
            "Modules\\Installer\\Database\\Factories\\": "Modules/Installer/database/factories/",
            "Modules\\Installer\\Database\\Seeders\\": "Modules/Installer/database/seeders/",
            "Modules\\Language\\": "Modules/Language/app/",
            "Modules\\Language\\Database\\Factories\\": "Modules/Language/database/factories/",
            "Modules\\Language\\Database\\Seeders\\": "Modules/Language/database/seeders/",
            "Modules\\Maintenance\\": "Modules/Maintenance/app/",
            "Modules\\Maintenance\\Database\\Factories\\": "Modules/Maintenance/database/factories/",
            "Modules\\Maintenance\\Database\\Seeders\\": "Modules/Maintenance/database/seeders/",
            "Modules\\Monitoring\\": "Modules/Monitoring/app/",
            "Modules\\Monitoring\\Database\\Factories\\": "Modules/Monitoring/database/factories/",
            "Modules\\Monitoring\\Database\\Seeders\\": "Modules/Monitoring/database/seeders/"
        },
        "files": [
            "app/Helpers/App.php",
            "app/Helpers/Plugin.php",
            "app/Helpers/Utils.php",
            "database/data/PageData.php",
            "database/data/utils/IntroSections.php",
            "database/data/utils/InnerSections.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "setup": [
            "composer install",
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php artisan key:generate",
            "@php artisan migrate --force",
            "npm install",
            "npm run build"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "npx concurrently -c \"#93c5fd,#c4b5fd,#fb7185,#fdba74\" \"php artisan serve\" \"php artisan queue:listen --tries=1 --timeout=0\" \"php artisan pail --timeout=0\" \"npm run dev\" --names=server,queue,logs,vite --kill-others"
        ],
        "dev:ssr": [
            "npm run build:ssr",
            "Composer\\Config::disableProcessTimeout",
            "npx concurrently -c \"#93c5fd,#c4b5fd,#fb7185,#fdba74\" \"php artisan serve\" \"php artisan queue:listen --tries=1\" \"php artisan pail --timeout=0\" \"php artisan inertia:start-ssr\" --names=server,queue,logs,ssr"
        ],
        "lint": [
            "pint --parallel"
        ],
        "lint:check": [
            "pint --parallel --test"
        ],
        "ci:check": [
            "Composer\\Config::disableProcessTimeout",
            "npm run lint:check",
            "npm run format:check",
            "npm run types:check",
            "@test"
        ],
        "test": [
            "@php artisan config:clear --ansi",
            "@lint:check",
            "@php artisan test"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ],
        "serve": [
            "Composer\\Config::disableProcessTimeout",
            "npx concurrently -c \"#93c5fd,#c4b5fd,#fb7185,#fdba74\" \"php artisan serve\" \"npm run dev\" --names=server,vite"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true,
            "wikimedia/composer-merge-plugin": true
        }
    },
    "minimum-stability": "stable"
}
